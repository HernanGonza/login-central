# Producción (valores FICTICIOS). Copiar a .env y completar; nunca commitear el .env real.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://portal:CAMBIAR@db:5432/portal
# Con path: el nginx de ecodatos quita /portal/ y la API ve /api/... y /.well-known/jwks.json
SSO_ISSUER=https://ecodatos.ecologia.misiones.gob.ar/portal
PORTAL_URL=https://ecodatos.ecologia.misiones.gob.ar/portal
PORTAL_BASE_PATH=/portal
SSO_PRIVATE_KEY_PATH=/run/secrets/sso_private_key.pem
SSO_KID=portal-2026-11
# Mínimo 32 caracteres (p. ej. openssl rand -hex 32)
ALTCHA_HMAC_KEY=reemplazar-por-64-hex-aleatorios-0123456789abcdef0123456789abcdef
# Dos saltos: nginx de ecodatos + nginx del portal
TRUST_PROXY=3
# Despliegue TEMPORAL con Personal de prueba (tabla `empleados`). Quitar al conectar el Personal real.
PERSONAL_ADAPTER=prueba
PORTAL_PERMITIR_ADAPTADOR_PRUEBA=1
# https o mailto
PERSONAL_REGISTRO_URL=https://personal.ejemplo.invalid/registro
PERSONAL_RECUPERO_URL=https://personal.ejemplo.invalid/recupero
# Opcionales (valores por defecto)
#ALTCHA_MAXNUMBER=1000000
#ALTCHA_LIMITE_IP_MIN=30
#LIMITE_VENTANA_SEG=900
#LIMITE_POR_PAR=5
#LIMITE_POR_IP=20
#LIMITE_POR_CORREO=50
#LIMITE_ENTRAR_MIN=30
#LIMITE_FORZAR_MIN=6
#TARJETAS_TIMEOUT_MS=3000
#TARJETAS_CACHE_SEG=600
#PURGA_INTERVALO_SEG=600
#JTI_RETENCION_DIAS=30
